# Variables de entorno para Elecciones (NO commitear el .env real)
# Copiar a .env y completar los valores

# Config Server (repo externo de properties)
CONFIG_SERVER_URI=https://github.com/Tito-67ai/elecciones-properties.git
CONFIG_SERVER_BRANCH=main

# Gateway
GATEWAY_INTERNAL_SECRET=EleccionesClaveInternaGateway2026

# JWT
JWT_SECRET=EleccionesClaveJwtSuperSecreta2026ParaFirmaHS256
JWT_EXPIRATION=3600

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Eureka
EUREKA_URI=http://registry:8761/eureka/

# Entorno
SPRING_PROFILES_ACTIVE=docker
